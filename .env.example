# Database
DATABASE_URL=postgresql://postgres:changeme@localhost:5434/atc_simulator
DATABASE_POOL_MIN_SIZE=5
DATABASE_POOL_MAX_SIZE=20

# Simulation
SIMULATION_TICK_RATE=20
MAX_AIRCRAFT=5000
OCTREE_MAX_DEPTH=8

# Landing Priority Weights
PRIORITY_WEIGHT_EMERGENCY=0.30
PRIORITY_WEIGHT_FUEL=0.35
PRIORITY_WEIGHT_SOULS=0.15
PRIORITY_WEIGHT_WAIT_TIME=0.10
PRIORITY_WEIGHT_RUNWAY=0.05

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# JWT (empty = auth disabled)
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Logging
LOG_LEVEL=INFO
DEBUG_MODE=false
